{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "image",
    "service"
  ],
  "properties": {
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "description": "Caddy image repository."
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "description": "Caddy image tag."
        }
      },
      "additionalProperties": false,
      "description": "Container image selection."
    },
    "service": {
      "type": "object",
      "required": [
        "httpPort",
        "httpsPort"
      ],
      "properties": {
        "httpPort": {
          "type": "integer",
          "minimum": 1,
          "description": "Host port published for HTTP.",
          "maximum": 65535
        },
        "httpsPort": {
          "type": "integer",
          "minimum": 1,
          "description": "Host port published for HTTPS.",
          "maximum": 65535
        }
      },
      "additionalProperties": false,
      "description": "Service exposure."
    }
  },
  "additionalProperties": false
}
