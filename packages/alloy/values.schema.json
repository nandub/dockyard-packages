{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "image",
    "service",
    "logLevel"
  ],
  "properties": {
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "description": "Grafana Alloy image repository."
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "description": "Grafana Alloy image tag."
        }
      },
      "additionalProperties": false,
      "description": "Container image selection."
    },
    "service": {
      "type": "object",
      "required": [
        "port"
      ],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "description": "Host port published for Alloy HTTP endpoint.",
          "maximum": 65535
        }
      },
      "additionalProperties": false,
      "description": "Service exposure."
    },
    "logLevel": {
      "type": "string",
      "minLength": 1,
      "description": "Alloy log level."
    }
  },
  "additionalProperties": false
}
