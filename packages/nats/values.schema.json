{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "image",
    "service"
  ],
  "properties": {
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "description": "NATS image repository."
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "description": "NATS image tag."
        }
      },
      "additionalProperties": false,
      "description": "Container image selection."
    },
    "service": {
      "type": "object",
      "required": [
        "clientPort",
        "monitorPort"
      ],
      "properties": {
        "clientPort": {
          "type": "integer",
          "minimum": 1,
          "description": "Host port published for NATS clients.",
          "maximum": 65535
        },
        "monitorPort": {
          "type": "integer",
          "minimum": 1,
          "description": "Host port published for NATS monitoring.",
          "maximum": 65535
        }
      },
      "additionalProperties": false,
      "description": "Service exposure."
    }
  },
  "additionalProperties": false
}
